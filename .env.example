# Values docker-compose.yml reads from a .env beside it.
#
# This file covers the local stack only. The server has its own, far longer
# list — see server/.env.example — and deployment is described in
# docs/DEPLOYMENT.md. Nothing here is used by Netlify or by a Docker host.

# Required: compose refuses to start without these two.
DB_PASSWORD=choose-a-local-password
JWT_SECRET=any-long-random-string-will-do-locally

# Optional. Without them the seeder creates admin@axis.com on first run.
# Generate the hash with:
#   node -e "require('bcryptjs').hash('your-password',12).then(console.log)"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=
