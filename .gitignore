# Node dependencies
node_modules/

# Build output
client/dist/
client/dist-ssr/
server/dist/
server/build/

# Generated by the client build (scripts/generate-sitemap.mjs)
client/public/sitemap.xml
client/public/robots.txt

# Database dumps. Kept locally as a safety net, never in version control —
# they can contain learner and parent data.
server/backups/

# Environment files
.env
.env.*.local

# Local Netlify folder
client/.netlify/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
*.swp

# Build caches and local tool state. These are regenerated on every build and
# differ per machine; committing them adds thousands of lines of churn to
# diffs and can serve a stale dependency graph to whoever checks the repo out.
client/.vite/
client/dist-ssr/
.netlify/

# Credentials. Nothing here is committed today and CI enforces that, but these
# are the filenames a secret tends to arrive in when someone is debugging.
*.key
*.pem
creds*.json
*-creds.json
secrets.json
.env.local

# Personal Claude Code settings — machine-specific, not the team's
.claude/settings.local.json
