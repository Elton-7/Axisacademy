# Client API Configuration
VITE_API_URL=http://localhost:5000/api

# Public site URL — used for canonical tags, Open Graph URLs and the sitemap.
# Set this to the real domain in the deploy environment.
VITE_SITE_URL=https://www.axislearning.co.ke

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset to ship with no analytics at all: when this is empty the tracking
# code is removed from the bundle entirely rather than merely disabled.
# Before enabling, confirm the consent position under the Data Protection Act 2019.
VITE_GA_MEASUREMENT_ID=
