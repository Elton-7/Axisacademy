{
  "name": "axis-academy-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "node scripts/generate-sitemap.mjs && tsc --noEmit && vite build && npm run build:ssr && node scripts/prerender.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --logLevel error",
    "build:spa": "node scripts/generate-sitemap.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "audit:contrast": "node scripts/contrast-audit.mjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "framer-motion": "^10.16.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.80.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  }
}
