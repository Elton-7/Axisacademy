# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axis_academy
DB_USER=postgres
DB_PASSWORD=4488

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication (generate ADMIN_PASSWORD_HASH with bcrypt before deployment)
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@axis.com
ADMIN_NAME=Admin User
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
TUTOR_EMAIL=tutor@axis.com
TUTOR_NAME=Axis Tutor
TUTOR_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
STUDENT_EMAIL=student@axis.com
STUDENT_NAME=Axis Student
STUDENT_PASSWORD_HASH=replace-with-a-bcrypt-password-hash

# Public site URL, used in notification emails to link back to the dashboard.
SITE_URL=https://www.axislearning.co.ke

# Enquiry notifications (brief §26, §43).
# Leave SMTP_HOST unset to disable sending entirely: notifications are then
# logged instead, so a missing credential can never silently drop a lead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM=Axis Learning <no-reply@axislearning.co.ke>
NOTIFICATION_TO=enquiries@axislearning.co.ke

# --- Startup behaviour ---------------------------------------------------
# alter rewrites existing tables to match the models and can drop columns;
# safe only creates missing ones. Production uses safe. See docs/DEPLOYMENT.md.
DB_SYNC=alter

# Migrations in server/migrations/ run at startup. Set true only when a
# release step runs `npm run migrate` instead (required past one instance).
SKIP_MIGRATIONS=false

# Seeding fills empty tables only; it never overwrites existing rows.
SKIP_SEED=false
