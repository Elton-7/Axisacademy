# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axis_academy
DB_USER=postgres
DB_PASSWORD=4488

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication (generate ADMIN_PASSWORD_HASH with bcrypt before deployment)
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@axis.com
ADMIN_NAME=Admin User
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
TUTOR_EMAIL=tutor@axis.com
TUTOR_NAME=Axis Tutor
TUTOR_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
STUDENT_EMAIL=student@axis.com
STUDENT_NAME=Axis Student
STUDENT_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
